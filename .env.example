# ---------------------------------------------------------------------------
# Database — Neon / Supabase / any Postgres
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. .env is gitignored;
# this file is committed, so it must never contain a real password.
#
# Two URLs, because the app and the migration engine need different connections.
#
# DATABASE_URL — the POOLED connection, used by the running app. Serverless
# functions open a connection per invocation, so without a pooler the database
# runs out of connections under any real traffic. On Neon this is the host with
# "-pooler" in it, plus ?pgbouncer=true so Prisma disables prepared statements
# (PgBouncer in transaction mode cannot keep them across queries).
#
# DIRECT_URL — the SAME database without the pooler, used only by
# `prisma migrate`. Migrations take advisory locks and run DDL in a session,
# neither of which survives a transaction-mode pooler; through PgBouncer they
# hang or fail. On Neon this is the identical string with "-pooler" removed
# from the hostname.
#
# On a plain Postgres with no pooler, set both to the same value.

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Canonical origin, used for canonical + Open Graph URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Salt for the one-way IP hash stored against each lead. Any long random
# string. Changing it makes previously stored hashes non-comparable.
IP_HASH_SALT="change-me-to-a-long-random-string"
