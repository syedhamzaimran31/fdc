# Postgres connection string (Neon, Supabase, or any Postgres).
# Neon:     postgresql://user:pass@ep-xxx.neon.tech/skyline?sslmode=require
# Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Canonical origin, used for canonical + Open Graph URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Salt for the one-way IP hash stored against each lead. Any long random
# string. Changing it makes previously stored hashes non-comparable.
IP_HASH_SALT="change-me-to-a-long-random-string"
