generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Pooled. Serverless opens a connection per invocation, so without the
  // pooler the connection limit is exhausted under real traffic.
  url = env("DATABASE_URL")

  // Migrations only. They take advisory locks and run DDL in a session, and
  // neither survives a transaction-mode pooler. Falls back to DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

/// An enum, not free text, so a reworded label cannot invalidate history.
enum BudgetRange {
  AED_900K_1_2M
  AED_1_2M_1_5M
  AED_1_5M_PLUS
}

/// Owned by the sales team. The landing page only ever writes NEW.
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
}

model Lead {
  id          String      @id @default(cuid())
  name        String      @db.VarChar(80)
  /// Deliberately not unique: the same buyer legitimately enquires twice, and
  /// rejecting the second attempt looks to them like a broken form.
  email       String      @db.VarChar(255)
  phone       String      @db.VarChar(20)
  budgetRange BudgetRange
  status      LeadStatus  @default(NEW)

  /// Server-side only. Never trusted from the request body.
  source      String?     @db.VarChar(120)
  ipHash      String?     @db.VarChar(64)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([email])
  @@index([status, createdAt])
  @@map("leads")
}
